# Supabase Configuration
# Replace these with your actual Supabase project URL and Anon/Public Key.
# If these variables are not set, the app will automatically fall back to a mock local auth database stored in localStorage.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Auth Flow Toggle
# Controls whether the app requires Sign In / Create Account before use.
# If unset (default), the app is fully open — no login required.
# Set to "true" to require authentication again.
VITE_ENABLE_AUTH=

VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=